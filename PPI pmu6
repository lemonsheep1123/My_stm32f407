// ==========================================
//           PINN 神经网络核心算法区
// ==========================================
static float rand_uniform(void) { return ((float)rand() / (float)RAND_MAX) * 2.0f - 1.0f; }
static float sigmoid(float x) { return (x >= 5.0f) ? 1.0f : ((x <= -5.0f) ? 0.0f : (1.0f / (1.0f + expf(-x)))); }
static float silu(float x) { return x * sigmoid(x); }
static float silu_derivative(float x, float sx) { return sx + sigmoid(x) * (1.0f - sx); }

// --- ✅ PPI 先验初始化：电气距离引导 + 输出层小权重 ---
void init_weights(void) {
    float b1_scale = sqrtf(6.0f / (IN + H1));
    float s2_scale = sqrtf(6.0f / (H1 + H2));
    float out_scale = sqrtf(6.0f / (H2 + OUT)) * 0.001f;   // 小权重防止输出过大

    for (int i = 0; i < H1; i++) {
        int focus = rand() % N_BUS;
        for (int j = 0; j < IN; j++) {
            float dist_scale = 1.0f;
            if (j % 4 == 0 || j % 4 == 1) {
                float d = ELEC_DIST[focus][j/4];
                dist_scale = 1.0f / (1.0f + d * 0.1f);
            }
            W1[i][j] = rand_uniform() * b1_scale * dist_scale;
        }
        b1[i] = 0.0f;
    }
    for (int i = 0; i < H2; i++) { for (int j = 0; j < H1; j++) W2[i][j] = rand_uniform() * s2_scale; b2[i] = 0.0f; }
    for (int i = 0; i < OUT; i++) { for (int j = 0; j < H2; j++) Wout[i][j] = rand_uniform() * out_scale; bout[i] = 0.0f; }
    memset(dW1, 0, sizeof(dW1)); memset(db1, 0, sizeof(db1));
    memset(dW2, 0, sizeof(dW2)); memset(db2, 0, sizeof(db2));
    memset(dWout, 0, sizeof(dWout)); memset(dbout, 0, sizeof(dbout));
}

void forward(float* input) {
    float scaled_input[IN];
    for (int j = 0; j < IN; j++) {
        if (j % 4 == 0 || j % 4 == 1) scaled_input[j] = input[j] * 100.0f;
        else scaled_input[j] = input[j];
    }

    for (int i = 0; i < H1; i++) {
        float s = b1[i];
        for (int j = 0; j < IN; j++) s += W1[i][j] * scaled_input[j];
        h1_in[i] = s; h1_out[i] = silu(s);
    }
    for (int i = 0; i < H2; i++) { float s = b2[i]; for (int j = 0; j < H1; j++) s += W2[i][j] * h1_out[j]; h2_in[i] = s; h2_out[i] = silu(s); }
    for (int i = 0; i < OUT; i++) { float s = bout[i]; for (int j = 0; j < H2; j++) s += Wout[i][j] * h2_out[j]; raw_out[i] = s; }

    for (int i = 0; i < N_BUS; i++) {
        V_pred[i] = V_BIAS + K_V * raw_out[i];
        theta_pred[i] = THETA_BIAS + K_THETA * raw_out[N_BUS + i];
    }
    V_pred[0] = 1.0f; theta_pred[0] = 0.0f;
}

float compute_physics_loss(float* input) {
    float loss = 0.0f;
    for (int i = 1; i < N_BUS; i++) {
        float P_t = input[i*4 + 0], Q_t = input[i*4 + 1];
        float P_p = 0.0f, Q_p = 0.0f;
        for (int k = 0; k < N_BUS; k++) {
            float dt = theta_pred[i] - theta_pred[k];
            float cos_d = 1.0f - 0.5f * dt * dt, sin_d = dt;
            P_p += V_pred[i] * V_pred[k] * (Ybus_G[i][k] * cos_d + Ybus_B[i][k] * sin_d);
            Q_p += V_pred[i] * V_pred[k] * (Ybus_G[i][k] * sin_d - Ybus_B[i][k] * cos_d);
        }
        loss += (P_p - P_t)*(P_p - P_t) + (Q_p - Q_t)*(Q_p - Q_t);
    }
    return loss / (N_BUS - 1);
}

void backward_and_update(float* input, float lr, int use_physics, float phys_weight) {
    float dV[N_BUS] = {0}, dT[N_BUS] = {0};
    float scale = 2.0f / (N_BUS - 1);

    if (use_physics) {
        for (int i = 1; i < N_BUS; i++) {
            float Vi = V_pred[i], ti = theta_pred[i], P_p = 0.0f, Q_p = 0.0f;
            for (int k = 0; k < N_BUS; k++) {
                float dt = ti - theta_pred[k];
                P_p += Vi * V_pred[k] * (Ybus_G[i][k]*(1.0f-0.5f*dt*dt) + Ybus_B[i][k]*dt);
                Q_p += Vi * V_pred[k] * (Ybus_G[i][k]*dt - Ybus_B[i][k]*(1.0f-0.5f*dt*dt));
            }
            float dp = P_p - input[i*4+0], dq = Q_p - input[i*4+1], dp_dv=0, dq_dv=0, dp_dt=0, dq_dt=0;
            for (int k = 0; k < N_BUS; k++) {
                float G = Ybus_G[i][k], B = Ybus_B[i][k], Vk = V_pred[k], dt = ti - theta_pred[k];
                if (i == k) { dp_dv += 2.0f*Vi*G; dq_dv -= 2.0f*Vi*B; }
                else { dp_dv += Vk*(G*(1-0.5f*dt*dt)+B*dt); dq_dv += Vk*(G*dt-B*(1-0.5f*dt*dt)); dp_dt += Vi*Vk*(-G*dt+B); dq_dt += Vi*Vk*(G+B*dt); }
            }
            dV[i] += phys_weight * scale*(dp*dp_dv + dq*dq_dv);
            dT[i] += phys_weight * scale*(dp*dp_dt + dq*dq_dt);
        }
    }

    float obs_w = 100.0f;
    for (int j = 0; j < 15; j++) {
        int idx = OBS_LIST[j]; if(idx==0)continue;
        dV[idx] += obs_w * 2.0f * (V_pred[idx] - input[idx*4+2]);
        dT[idx] += obs_w * 100.0f * 2.0f * (theta_pred[idx] - input[idx*4+3]);
    }

    for (int i=1; i<N_BUS; i++) {
        if(dV[i] > 1.0f) dV[i] = 1.0f; if(dV[i] < -1.0f) dV[i] = -1.0f;
        if(dT[i] > 1.0f) dT[i] = 1.0f; if(dT[i] < -1.0f) dT[i] = -1.0f;
    }

    float dRaw[OUT] = {0};
    for (int i = 1; i < N_BUS; i++) { dRaw[i] = K_V * dV[i]; dRaw[N_BUS + i] = K_THETA * dT[i]; }

    float dh2[H2] = {0};
    for (int i = 0; i < OUT; i++) {
        float grad = dRaw[i];
        for (int j = 0; j < H2; j++) { dWout[i][j] += grad * h2_out[j]; dh2[j] += grad * Wout[i][j]; }
        dbout[i] += grad;
    }

    float dh1[H1] = {0};
    for (int i = 0; i < H2; i++) {
        float grad = dh2[i] * silu_derivative(h2_in[i], h2_out[i]);
        for (int j = 0; j < H1; j++) { dW2[i][j] += grad * h1_out[j]; dh1[j] += grad * W2[i][j]; }
        db2[i] += grad;
    }

    float scaled_input[IN];
    for (int j = 0; j < IN; j++) {
        if (j % 4 == 0 || j % 4 == 1) scaled_input[j] = input[j] * 100.0f;
        else scaled_input[j] = input[j];
    }

    for (int i = 0; i < H1; i++) {
        float grad = dh1[i] * silu_derivative(h1_in[i], h1_out[i]);
        for (int j = 0; j < IN; j++) dW1[i][j] += grad * scaled_input[j];
        db1[i] += grad;
    }
}

void apply_gradients(float lr) {
    for (int i = 0; i < H1; i++) { for (int j = 0; j < IN; j++) { W1[i][j] -= lr * dW1[i][j]; dW1[i][j] = 0.0f; } b1[i] -= lr * db1[i]; db1[i] = 0.0f; }
    for (int i = 0; i < H2; i++) { for (int j = 0; j < H1; j++) { W2[i][j] -= lr * dW2[i][j]; dW2[i][j] = 0.0f; } b2[i] -= lr * db2[i]; db2[i] = 0.0f; }
    for (int i = 0; i < OUT; i++) { for (int j = 0; j < H2; j++) { Wout[i][j] -= lr * dWout[i][j]; dWout[i][j] = 0.0f; } bout[i] -= lr * dbout[i]; dbout[i] = 0.0f; }
}

void evaluate_accuracy(void) {
    float sum_v = 0, sum_t = 0;
    float sum_sq_v = 0, sum_sq_t = 0;
    int count = N_TRAIN_REAL * N_BUS;
    for (int s = 0; s < N_TRAIN_REAL; s++) {
        forward((float*)X_train_real[s]);
        for (int i = 0; i < N_BUS; i++) {
            float dv = V_pred[i] - X_train_real[s][i*4+2];
            float dt = theta_pred[i] - X_train_real[s][i*4+3];
            sum_v += fabsf(dv);
            sum_t += fabsf(dt);
            sum_sq_v += dv * dv;
            sum_sq_t += dt * dt;
        }
    }
    float mae_v = sum_v / count;
    float mae_t = sum_t / count;
    float rmse_v = sqrtf(sum_sq_v / count);
    float rmse_t = sqrtf(sum_sq_t / count);
    printf("\r\n>>> PPI6 (PMU6) 最终精度: V MAE = %.6f, Theta MAE = %.6f\r\n", mae_v, mae_t);
    printf(">>> RMSE: V RMSE = %.6f, Theta RMSE = %.6f\r\n", rmse_v, rmse_t);
}

