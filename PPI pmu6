    printf("\r\n=========================================\r\n");
    printf("  运行: 边缘设备分阶段训练开始 (PPI6 方案)\r\n");
    printf("=========================================\r\n");

    // 训练开始前，红灯常亮提示“正在计算”
    HAL_GPIO_WritePin(GPIOF, GPIO_PIN_6, GPIO_PIN_RESET);  // 红灯亮
    HAL_GPIO_WritePin(GPIOF, GPIO_PIN_7, GPIO_PIN_SET);
    HAL_GPIO_WritePin(GPIOF, GPIO_PIN_8, GPIO_PIN_SET);

    for (int epoch = 0; epoch < epochs; epoch++) {
        float epoch_phys_loss = 0.0f;
        float epoch_obs_loss  = 0.0f;

        int use_physics = (epoch >= warmup_epochs) ? 1 : 0;
        float phys_weight = use_physics ? 0.01f : 0.0f;

        for (int s = 0; s < N_TRAIN_REAL; s++) {
            forward((float*)X_train_real[s]);

            if (use_physics) {
                epoch_phys_loss += compute_physics_loss((float*)X_train_real[s]);
            }

            float obs_loss = 0.0f;
            for (int j = 0; j < 15; j++) {
                int idx = OBS_LIST[j];
                float dv = V_pred[idx] - X_train_real[s][idx*4+2];
                float dt = theta_pred[idx] - X_train_real[s][idx*4+3];
                obs_loss += dv*dv + 1000.0f*dt*dt;
            }
            epoch_obs_loss += obs_loss / 15.0f;

            backward_and_update((float*)X_train_real[s], lr, use_physics, phys_weight);
            if ((s + 1) % 32 == 0 || s == N_TRAIN_REAL - 1) {
                apply_gradients(lr / 32.0f);
            }
        }

        if (epoch == warmup_epochs) {
            lr = lr_finetune;
            printf("--- 物理损失已激活，学习率降至 %.6f ---\r\n", lr);
        }

        if ((epoch+1)%10 == 0 || epoch == 0) {
            printf("Epoch %2d/%d | LR:%.6f | Physics:%s | ObsLoss:%.6f | PhysLoss:%.6f\r\n",
                   epoch+1, epochs, lr, use_physics ? "ON" : "OFF",
                   epoch_obs_loss / N_TRAIN_REAL,
                   use_physics ? epoch_phys_loss / N_TRAIN_REAL : 0.0f);
        }
    }

    evaluate_accuracy();

    int s_idx = N_TRAIN_REAL - 1;
    forward((float*)X_train_real[s_idx]);
    float vt[33], vp[33], tt[33], tp[33];
    for(int i = 0; i < 33; i++) {
        vt[i] = X_train_real[s_idx][i*4 + 2];
        vp[i] = V_pred[i];
        tt[i] = X_train_real[s_idx][i*4 + 3];
        tp[i] = theta_pred[i];
    }

    // 调用串口绘图函数
    plot_voltage_profile_serial(33, vt, vp);
    plot_angle_profile_serial(33, tt, tp);
    audit_predictions_serial();

    printf("\r\n>>> 训练与输出全部完成！单片机进入待机流水灯模式 <<<\r\n");
    /* USER CODE END 2 */

    /* Infinite loop */
    while (1)
    {
        /* USER CODE BEGIN 3 */
        // 训练完成后，流水灯开始跳动
        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_6, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_7, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_8, GPIO_PIN_SET);
        HAL_Delay(300);

        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_6, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_7, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_8, GPIO_PIN_SET);
        HAL_Delay(300);

        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_6, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_7, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOF, GPIO_PIN_8, GPIO_PIN_RESET);
        HAL_Delay(300);
        /* USER CODE END 3 */
    }
}

